From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Roland Ma <rolandma@outlook.com>
Date: Wed, 31 Dec 2025 08:42:02 +0000
Subject: fix:add Mali GPU memory leak patch

Layer tree failed callback cause memory leaks, because timing not consistent when use glGetInteger64v on mali GPU. Force glGetInteger64v only works on GLES 3.2

diff --git a/third_party/blink/renderer/platform/widget/compositing/layer_tree_view.cc b/third_party/blink/renderer/platform/widget/compositing/layer_tree_view.cc
index 635fa41649db41800f99da2683cc955b2e1e935f..b0a9edce922caed03f7f814af851c5c5a0d3d677 100644
--- a/third_party/blink/renderer/platform/widget/compositing/layer_tree_view.cc
+++ b/third_party/blink/renderer/platform/widget/compositing/layer_tree_view.cc
@@ -432,6 +432,12 @@ void LayerTreeView::DidPresentCompositorFrame(
              ->RunsTasksInCurrentSequence());
   // Only run callbacks on successful presentations.
   if (frame_timing_details.presentation_feedback.failed()) {
+    // If the presentation failed, drop the callbacks for this frame
+    // token. This is to avoid running callbacks for frames that were never
+    // presented.
+    if (viz::FrameTokenGT(frame_token, 0u)) {
+      LOG(WARNING) << "Presentation failed for frame token: " << frame_token;
+    }
     return;
   }
   while (!presentation_callbacks_.empty()) {
@@ -560,6 +566,10 @@ void LayerTreeView::AddCallback(
   std::vector<Callback> new_callbacks;
   new_callbacks.push_back(std::move(callback));
   callbacks.emplace_back(frame_token, std::move(new_callbacks));
+  if (callbacks.size() > cc::PresentationTimeCallbackBuffer::kMaxBufferSize) {
+    LOG(WARNING) << "Presentation callbacks buffer size exceeded: "
+                 << callbacks.size();
+  }
   DCHECK_LE(callbacks.size(),
             cc::PresentationTimeCallbackBuffer::kMaxBufferSize);
 }
diff --git a/ui/gl/gpu_timing.cc b/ui/gl/gpu_timing.cc
index bf175e7ab5e8c8398b9cb233f1346488b50889ce..c7d28518cb0cc444802fe236bfd0429177dcd00a 100644
--- a/ui/gl/gpu_timing.cc
+++ b/ui/gl/gpu_timing.cc
@@ -331,7 +331,7 @@ GPUTimingImpl::GPUTimingImpl(GLContextReal* context) {
   // The command glGetInteger64v is only supported under ES3 and GL3.2. Since it
   // is only used for timestamps, we workaround this by emulating timestamps
   // so WebGL 1.0 will still have access to the extension.
-  if (!version_info->IsAtLeastGLES(3, 0)) {
+  if (!version_info->IsAtLeastGLES(3, 2)) {
     force_time_elapsed_query_ = true;
     timestamp_bit_count_gl_ = 0;
   }
